# Copie este arquivo para ".env" (na raiz do projeto) e preencha com as
# chaves do seu projeto Firebase (Console do Firebase > Configurações do
# projeto > Seus apps > Configuração do SDK).
#
# IMPORTANTE: o arquivo ".env" NÃO deve ser commitado no Git (já está no
# .gitignore). Cada ambiente (dev, homologação, produção) deve ter o seu.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
# Web Push (FCM) — gere em Firebase Console > Configurações do projeto >
# Cloud Messaging > Certificados/Pares de chaves do Web Push ("Chave do servidor"
# do par VAPID). Necessária para o push "com app fechado" (Web Push/FCM).
REACT_APP_FIREBASE_VAPID_KEY=
