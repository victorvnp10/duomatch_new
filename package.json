{
  "name": "duomatch-app",
  "version": "1.0.0",
  "description": "Aplicativo web para casais planejarem atividades.",
  "main": "src/index.js",
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.6.1",
    "firebase": "^9.6.10",
    "postcss": "^8.5.6",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "jest --runInBand",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "preview": "vite preview",
    "pretest:e2e": "npm --prefix functions run build:catalog",
    "test:e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-duomatch-e2e --config firebase.e2e.json \"playwright test\"",
    "test:e2e:browser": "playwright test",
    "test:build": "node --test test/vite-migration.test.cjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.28.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^3.4.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "overrides": {
    "protobufjs": "^7.6.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
