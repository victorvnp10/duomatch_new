    function isCatalogChallengeId(docId) {
      return docId in "week-activities,week-adventure,week-appreciation,week-breakfast-bed,week-bucket-list,week-childhood,week-compliment-public,week-compliments,week-cooking,week-creative,week-dance,week-date-night,week-dreams,week-favorite-meal,week-favorite-things,week-future-talk,week-game,week-goals,week-gratitude,week-handwritten,week-laugh,week-learning,week-local-explore,week-love-language,week-m6-abraco-diario,week-m6-album-da-semana,week-m6-aprender-juntos,week-m6-ar-livre-3x,week-m6-bilhetes-de-amor,week-m6-brincadeira-do-dia,week-m6-cafe-manha-junto,week-m6-carta-reconhecimento,week-m6-check-in-diario,week-m6-contato-sem-pressa,week-m6-conversa-sem-julgamento,week-m6-convite-surpresa,week-m6-cuidado-mutuo,week-m6-danca-a-dois,week-m6-declaracao-da-semana,week-m6-desafio-de-coragem,week-m6-diario-de-casal,week-m6-elogio-diario-mensagem,week-m6-elogio-sincero,week-m6-exercicio-a-dois,week-m6-feedback-gentil,week-m6-gratidao-diaria,week-m6-hidratacao-em-dupla,week-m6-historia-inventada,week-m6-hobby-compartilhado,week-m6-hora-sagrada,week-m6-jogo-em-dupla,week-m6-livro-a-dois,week-m6-maratona-cultural,week-m6-meme-do-dia,week-m6-metas-do-casal,week-m6-momento-de-respirar,week-m6-musica-do-dia,week-m6-noite-de-jogos,week-m6-noite-romantica,week-m6-novo-lugar,week-m6-orcamento-a-dois,week-m6-piquenique-ao-ar-livre,week-m6-planejar-mes,week-m6-playlist-da-semana,week-m6-presente-inesperado,week-m6-projeto-criativo,week-m6-refeicao-saudavel,week-m6-reflexao-do-casal,week-m6-reforma-criativa,week-m6-relembrar-comeco,week-m6-reviver-primeiro-encontro,week-m6-rota-alternativa,week-m6-sem-distracoes-refeicao,week-m6-semana-sem-brigas,week-m6-show-em-casa,week-m6-show-ou-evento,week-m6-sono-em-dia,week-m6-surpresa-da-semana,week-m6-surpresa-romantica,week-m6-tarefa-em-dupla,week-m6-tres-atividades-novas,week-m6-tres-conversas-profundas,week-m6-tres-risadas-garantidas,week-m6-trilha-ou-caminhada,week-m7-agradecer-por-escrito,week-m7-alongamento-a-dois,week-m7-assist