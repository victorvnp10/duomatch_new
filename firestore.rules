rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function couplePath(coupleId) {
      return /databases/$(database)/documents/duomatches/$(coupleId);
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() &&
        request.auth.uid in get(couplePath(coupleId)).data.members;
    }

    function hasEmptyRelationship(data) {
      return data.get('partnerId', null) == null &&
        data.get('coupleId', null) == null;
    }

    // CATALOG-ALLOWLIST:START
    // Allowlist de ids do catálogo global. GERADO AUTOMATICAMENTE de
    // src/infrastructure/seed/contentCatalog.js — NÃO editar à mão.
