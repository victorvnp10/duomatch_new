rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regra para a coleção 'users' com a lógica de atualização corrigida
    match /users/{userId} {
      allow create: if request.auth.uid != null;
      allow read: if request.auth.uid != null;

      // --- A REGRA CORRIGIDA ESTÁ AQUI ---
      // Permite a atualização em duas condições:
      // 1. O usuário está atualizando seu próprio perfil.
      // 2. OU o usuário está se vinculando a um parceiro que ainda não está vinculado,
      //    e está alterando APENAS os campos 'partnerId' e 'coupleId'.
      allow update: if (request.auth.uid == userId) ||
                       (request.auth.uid != null && resource.data.partnerId == null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId', 'coupleId']));
    }

    // Regra para a coleção 'inviteCodes'
    match /inviteCodes/{code} {
      allow read, create, delete: if request.auth.uid != null;
    }

    // Regra para os tokens de Web Push (FCM) — um doc por usuário, vários devices.
    // O cliente grava via setDoc+merge: cria (se não existe) ou atualiza (se existe).
    // As Cloud Functions usam o SDK admin e não passam por estas regras.
    match /pushTokens/{uid} {
      allow read, update: if request.auth.uid == uid;
      allow create: if request.auth.uid == request.resource.data.uid;
    }

    // Regra principal para os dados do casal
    match /duomatches/{coupleId} {
      allow create: if request.auth.uid in request.resource.data.members;
      allow read, update, delete: if request.auth.uid in resource.data.members;

      // Regra para todas as subcoleções (activities, rounds, etc.)
      match /{subcollection}/{docId=**} {
          allow read, write: if request.auth.uid in get(/databases/$(database)/documents/duomatches/$(coupleId)).data.members;
      }
    }

    // Catálogo global de conteúdo (sugestões do dia/hot e desafios).
    // Fonte de verdade plantada pelo cliente (ContentRepository, seed por
    // upsert — grava só os id ausentes via create). Leitura liberada para
    // qualquer usuário autenticado; escrita apenas via create (seed idempotente).
    match /contentActivities/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
    match /contentChallenges/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}