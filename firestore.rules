week-sunset,week-surprise,week-surprise-note,week-thank-you,week-touch,week-video-call,week-vision-board,week-walk,week-week-5-kisses-12,week-week-books-4,week-week-brunch-26,week-week-chef-25,week-week-coffee-date-11,week-week-compliment-family-18,week-week-couple-money-33,week-week-couple-quiz-8,week-week-dance-1-22,week-week-dinner-candle-14,week-week-early-5,week-week-favorite-song-7,week-week-future-letter-42,week-week-gift-mini-24,week-week-gratitude-5-0,week-week-handwritten-10,week-week-hug-30-13,week-week-hug-tree-39,week-week-hydration-3,week-week-kiss-o-clock-43,week-week-laugh-9,week-week-letters-future-28,week-week-memory-map-23,week-week-mini-date-31,week-week-music-album-40,week-week-neighbor-tour-41,week-week-new-hobby-15,week-week-no-sugar-2,week-week-no-tv-day-36,week-week-phone-free-17,week-week-photo-word-6,week-week-plan-trip-19,week-week-play-games-21,week-week-price-dinner-45,week-week-question-deck-44,week-week-redecorate-27,week-week-shared-playlist-1,week-week-sleep-early-35,week-week-slow-kiss-38,week-week-sport-34,week-week-stars-20,week-week-sunrise-30,week-week-thanks-letter-32,week-week-think-aloud-37,week-week-walk-1h-16,week-week-water-fight-29,week-workout".split(',');
    }
    // CATALOG-ALLOWLIST:END

    function isSafeProfileUpdate(userId) {
      return isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nickname', 'gender', 'birthDate', 'photoURL', 'avatar',
          'onboardingSkipped', 'seenWishlistItems'
        ]) &&
        request.resource.data.get('uid', '') == resource.data.get('uid', '') &&
        request.resource.data.get('email', '') == resource.data.get('email', '') &&
        request.resource.data.get('partnerId', null) == resource.data.get('partnerId', null) &&
        request.resource.data.get('coupleId', null) == resource.data.get('coupleId', null);
    }

    // Prova de consentimento do convite.
    // O convite é o ÚNICO artefato que um atacante não consegue forjar: a
    // regra de create de `inviteCodes` exige creatorId == request.auth.uid,
    // logo um convite com creatorId == invitedUserId só pode ter sido criado
    // pelo próprio usuário convidado. O documento do casal guarda o código
    // usado (campo `inviteCode`) e aqui conferimos que esse convite existia
    // ANTES da transação (get, não getAfter — o fluxo legítimo consome/apaga o
    // convite na mesma transação), que aponta para ESTE casal e que foi criado
    // por QUEM está sendo vinculado.
    function hasInviteConsent(inviteCode, invitedUserId, coupleId) {
      return inviteCode is string &&
        inviteCode.size() > 0 &&
        exists(/databases/$(database)/documents/inviteCodes/$(inviteCode)) &&
        get(/databases/$(database)/documents/inviteCodes/$(inviteCode)).data.get('creatorId', '') == invitedUserId &&
        get(/databases/$(database)/documents/inviteCodes/$(inviteCode)).data.get('coupleId', '') == coupleId &&
        // ACHADO M-1: o convite tem validade explícita. Um convite sem
        // expiresAt (formato antigo) ou já vencido não serve para vincular.
        get(/databases/$(database)/documents/inviteCodes/$(inviteCode)).data.get('expiresAt', null) is timestamp &&
        get(/databases/$(database)/documents/inviteCodes/$(inviteCode)).data.expiresAt > request.time;
    }

    function isLinkingUserUpdate(userId) {
      return isSignedIn() &&
        resource.data.get('partnerId', null) == null &&
        resource.data.get('coupleId', null) == null &&
        request.resource.data.get('partnerId', null) is string &&
        request.resource.data.get('coupleId', null) is string &&
        request.resource.data.get('partnerId', null) != null &&
        request.resource.data.get('coupleId', null) != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'partnerId', 'coupleId'
        ]) &&
        getAfter(couplePath(request.resource.data.coupleId)).data.createdBy == request.auth.uid &&
        getAfter(couplePath(request.resource.data.coupleId)).data.members.size() == 2 &&
        request.auth.uid in getAfter(couplePath(request.resource.data.coupleId)).data.members &&
        userId in getAfter(couplePath(request.resource.data.coupleId)).data.members &&
        (
          (userId == request.auth.uid &&
            request.resource.data.partnerId == getAfter(couplePath(request.resource.data.coupleId)).data.invitedUserId) ||
          (userId == getAfter(couplePath(request.resource.data.coupleId)).data.invitedUserId &&
            request.resource.data.partnerId == request.auth.uid &&
            getAfter(couplePath(request.resource.data.coupleId)).data.keys().hasAll(['inviteCode']) &&
            hasInviteConsent(
              getAfter(couplePath(request.resource.data.coupleId)).data.inviteCode,
              userId,
              request.resource.data.coupleId))
        );
    }

    function isUnlinkingUserUpdate(userId) {
      return isSignedIn() &&
        (userId == request.auth.uid || resource.data.get('partnerId', null) == request.auth.uid) &&
        resource.data.get('coupleId', null) != null &&
        request.resource.data.get('partnerId', null) == null &&
        request.resource.data.get('coupleId', null) == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'partnerId', 'coupleId', 'onboardingSkipped'
        ]) &&
        isCoupleMember(resource.data.coupleId);
    }

    // Regra para a coleção 'users' com a lógica de atualização corrigida
    match /users/{userId} {
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.get('uid', '') == userId &&
        hasEmptyRelationship(request.resource.data) &&
        request.resource.data.keys().hasOnly([
          'uid', 'nickname', 'gender', 'email', 'createdAt', 'partnerId',
          'coupleId', 'birthDate', 'photoURL', 'avatar', 'score',
          'onboardingSkipped', 'seenWishlistItems'
        ]);
      allow get: if isSignedIn() &&
        (request.auth.uid == userId ||
          (resource.data.get('partnerId', null) == request.auth.uid &&
            resource.data.get('coupleId', null) != null &&
            isCoupleMember(resource.data.coupleId)));
      allow list: if false;

      // --- A REGRA CORRIGIDA ESTÁ AQUI ---
      // Permite a atualização em duas condições:
      // 1. O usuário está atualizando seu próprio perfil.
      // 2. OU o usuário está se vinculando a um parceiro que ainda não está vinculado,
      //    e está alterando APENAS os campos 'partnerId' e 'coupleId'.
      allow update: if isSafeProfileUpdate(userId) ||
        isLinkingUserUpdate(userId) ||
        isUnlinkingUserUpdate(userId);
      allow delete: if false;
    }

    // Regra para a coleção 'inviteCodes'
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      // ACHADO M-1: todo convite passa a ter validade explícita (`expiresAt`).
      // Sem isso o código — que antes era curto e previsível — valia para
      // sempre e podia ser varrido/consumido por um terceiro. Teto de 48h
      // impede que um cliente malicioso crie um convite "eterno" (o app usa 24h).
      allow create: if isSignedIn() &&
        request.resource.data.get('creatorId', '') == request.auth.uid &&
        request.resource.data.get('coupleId', '') is string &&
        request.resource.data.get('coupleId', '') != '' &&
        request.resource.data.keys().hasOnly([
          'creatorId', 'creatorNickname', 'coupleId', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'creatorId', 'creatorNickname', 'coupleId', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(2, 'd');
      allow update: if false;
      allow delete: if isSignedIn() &&
        (resource.data.get('creatorId', '') == request.auth.uid ||
          (resource.data.get('coupleId', null) is string &&
            resource.data.get('coupleId', '') != '' &&
            getAfter(couplePath(resource.data.coupleId)).data.members.size() == 2 &&
            getAfter(couplePath(resource.data.coupleId)).data.createdBy == request.auth.uid &&
            getAfter(couplePath(resource.data.coupleId)).data.invitedUserId == resource.data.creatorId &&
            request.auth.uid in getAfter(couplePath(resource.data.coupleId)).data.members &&
            resource.data.creatorId in getAfter(couplePath(resource.data.coupleId)).data.members));
    }

    // Regra para os tokens de Web Push (FCM) — um doc por usuário, vários devices.
    // O cliente grava via setDoc+merge: cria (se não existe) ou atualiza (se existe).
    // As Cloud Functions usam o SDK admin e não passam por estas regras.
    match /pushTokens/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.get('uid', '') == uid &&
        request.resource.data.keys().hasOnly(['uid', 'tokens', 'updatedAt']);
      allow delete: if false;
    }

    // Integrity checks apply only when a field changes: unrelated writes must
    // not strand couples containing legacy data. Missing numeric counters = 0.
    function validAggregates() {
      let fields = request.resource.data.diff(resource.data).affectedKeys();
      return validCounters(fields) && validLists(fields) && validMaps(fields);
    }

    function validCounters(fields) {
      let next = request.resource.data;
      let old = resource.data;
      let intimacy = old.get('intimacyPoints', null) == null ? 0 : old.intimacyPoints;
      let messages = old.get('messageCount', null) == null ? 0 : old.messageCount;
      return (!fields.hasAny(['streak']) ? true :
          (next.streak is int && next.streak >= 1 &&
            (next.streak == 1 || next.streak == old.get('streak', 0) + 1))) &&
        (!fields.hasAny(['intimacyPoints']) ? true :
          (next.intimacyPoints is int && next.intimacyPoints >= 0 &&
            next.intimacyPoints == intimacy + 1)) &&
        // Deletion is a separate client write; legacy counters can go negative.
        (!fields.hasAny(['messageCount']) ? true :
          (next.messageCount is int &&
            (next.messageCount == messages + 1 ||
             next.messageCount == messages - 1)));
    }

    function validAchievements() {
      let next = request.resource.data.achievements;
      let previous = resource.data.get('achievements', null);
      let old = previous == null ? [] : previous;
      return next is list && next.size() <= 12 &&
        next.toSet().size() == next.size() && next.hasAll(old) &&
        next.hasOnly([
          'first_activity', 'first_match', 'first_hot_match', 'first_hot_challenge',
          'first_challenge', 'challenge_streak_5', 'challenge_master', 'streak_7',
          'communicator', 'big_spender', 'hot_streak', 'wish_granter'
        ]);
    }

    function validRecentActivities() {
      let next = request.resource.data.recentActivityIds;
      let previous = resource.data.get('recentActivityIds', null);
      let old = previous == null ? [] : previous;
      let added = next.removeAll(old);
      return next is list && next.hasAll(old) &&
        next.toSet().size() == next.size() && added.size() <= 5 &&
        catalogActivityIds().hasAll(added);
    }

    function validRecentChallenges() {
      let next = request.resource.data.recentChallengeIds;
      let previous = resource.data.get('recentChallengeIds', null);
      let old = previous == null ? [] : previous;
      let added = next.removeAll(old);
      return next is list && next.hasAll(old) &&
        next.toSet().size() == next.size() && added.size() <= 1 &&
        (added.size() == 0 || isCatalogChallengeId(added[0]));
    }

    function validLists(fields) {
      return (!fields.hasAny(['achievements']) ? true : validAchievements()) &&
        (!fields.hasAny(['recentActivityIds']) ? true : validRecentActivities()) &&
        (!fields.hasAny(['recentChallengeIds']) ? true : validRecentChallenges());
    }

    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validSignals() {
      let next = request.resource.data.dailySignals;
      let previous = resource.data.get('dailySignals', null);
      let old = previous is map ? previous : {};
      let oldDate = old.get('date', '');
      return next is map && next.keys().hasOnly(['date', 'signals']) &&
        isDate(next.date) && next.signals is map &&
        next.signals.keys().hasOnly(resource.data.members) &&
        next.signals.get(request.auth.uid, '') in ['willing', 'unsure', 'resting'] &&
        (next.date == oldDate
          ? next.signals.diff(old.get('signals', {})).affectedKeys().hasOnly([request.auth.uid])
          : (next.date > oldDate && next.signals.keys().hasOnly([request.auth.uid])));
    }

    function validPeriod(p) {
      return p is map && p.keys().hasOnly(['startDate', 'periodLength']) &&
        p.startDate is string && p.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        p.periodLength is number && p.periodLength >= 1 && p.periodLength <= 10;
    }

    function validCycle() {
      let next = request.resource.data.cycleTracking;
      let previous = resource.data.get('cycleTracking', null);
      let old = previous is map ? previous : {};
      return next is map &&
        next.keys().hasOnly(['ownerId', 'periods', 'cycleLengthOverride']) &&
        next.ownerId == request.auth.uid &&
        (old.get('ownerId', null) == null || next.ownerId == old.ownerId) &&
        next.periods is list && next.periods.size() <= 12 &&
        (next.cycleLengthOverride == null ||
          (next.cycleLengthOverride is number && next.cycleLengthOverride >= 15 &&
            next.cycleLengthOverride <= 60)) &&
        (next.periods.size() <= 0 || validPeriod(next.periods[0])) &&
        (next.periods.size() <= 1 || validPeriod(next.periods[1])) &&
        (next.periods.size() <= 2 || validPeriod(next.periods[2])) &&
        (next.periods.size() <= 3 || validPeriod(next.periods[3])) &&
        (next.periods.size() <= 4 || validPeriod(next.periods[4])) &&
        (next.periods.size() <= 5 || validPeriod(next.periods[5])) &&
        (next.periods.size() <= 6 || validPeriod(next.periods[6])) &&
        (next.periods.size() <= 7 || validPeriod(next.periods[7])) &&
        (next.periods.size() <= 8 || validPeriod(next.periods[8])) &&
        (next.periods.size() <= 9 || validPeriod(next.periods[9])) &&
        (next.periods.size() <= 10 || validPeriod(next.periods[10])) &&
        (next.periods.size() <= 11 || validPeriod(next.periods[11]));
    }

    // Partial validation only: the client rewrites one dynamically keyed week.
    // Nested confirmations/points still require authoritative backend writes.
    function validWeeklyEnvelope() {
      let next = request.resource.data.weeklyChallenge;
      let previous = resource.data.get('weeklyChallenge', null);
      let old = previous is map ? previous : {};
      return next is map && next.keys().hasAll(old.keys()) &&
        next.diff(old).affectedKeys().size() <= 1;
    }

    function validMaps(fields) {
      return (!fields.hasAny(['dailySignals']) ? true : validSignals()) &&
        (!fields.hasAny(['cycleTracking']) ? true :
          (request.resource.data.keys().hasAll(['cycleTracking']) ? validCycle() : false)) &&
        (!fields.hasAny(['weeklyChallenge']) ? true : validWeeklyEnvelope());
    }

    // Regra principal para os dados do casal
    match /duomatches/{coupleId} {
      allow create: if isSignedIn() &&
        // linkingService creates no aggregates; seed them only via validated updates.
        !request.resource.data.keys().hasAny([
          'streak', 'intimacyPoints', 'messageCount', 'achievements',
          'recentActivityIds', 'recentChallengeIds', 'dailySignals',
          'cycleTracking', 'weeklyChallenge'
        ]) &&
        request.auth.uid == request.resource.data.get('createdBy', '') &&
        request.resource.data.get('members', []).size() == 2 &&
        request.resource.data.members[0] != request.resource.data.members[1] &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.get('invitedUserId', '') in request.resource.data.members &&
        request.resource.data.get('memberNicknames', {}).keys().hasAll(request.resource.data.members) &&
        // Sem convite do usuário incluído não existe casal: o criador do doc
        // não pode simplesmente "declarar" que a outra pessoa consentiu.
        request.resource.data.keys().hasAll(['inviteCode', 'invitedUserId']) &&
        hasInviteConsent(
          request.resource.data.inviteCode,
          request.resource.data.invitedUserId,
          coupleId);
      allow read: if isCoupleMember(coupleId);
      allow update: if isCoupleMember(coupleId) && validAggregates() &&
        request.resource.data.members == resource.data.members &&
        request.resource.data.get('memberNicknames', {}) == resource.data.get('memberNicknames', {}) &&
        request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') &&
        request.resource.data.get('invitedUserId', '') == resource.data.get('invitedUserId', '');
      allow delete: if isCoupleMember(coupleId);

      // Regra para todas as subcoleções (activities, rounds, etc.)
      match /{subcollection}/{docId=**} {
          allow read, write: if isCoupleMember(coupleId);
      }
    }

    // Catálogo global de conteúdo (sugestões do dia/hot e desafios).
    // Fonte de verdade plantada pelo cliente (ContentRepository, seed por
    // upsert — grava só os id ausentes via create). Leitura liberada para
    // qualquer usuário autenticado; escrita apenas via create (seed idempotente).
    //
    // ACHADO A-1: sem checagem de autoria, qualquer usuário autenticado podia
    // injetar entradas arbitrárias no catálogo compartilhado (poluição global).
    // Como o seed roda no cliente (não há backend), a mitigação mínima é exigir
    // que o `docId` pertença ao conjunto de ids realmente publicados pelo app
    // (allowlist gerada do contentCatalog) + validar o tipo/tamanho dos campos.
    // Assim o seed legítimo continua passando, mas a injeção de itens novos é
    // negada. Residual documentado em RELATORIO-SEGURANCA-2.md.
    match /contentActivities/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.get('id', '') == docId &&
        isCatalogActivityId(docId) &&
        request.resource.data.keys().hasOnly([
          'id', 'name', 'category', 'points', 'description', 'flavor', 'active'
        ]) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
        request.resource.data.category is string && request.resource.data.category.size() <= 40 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 400 &&
        request.resource.data.points is int && request.resource.data.points >= 0 && request.resource.data.points <= 100 &&
        request.resource.data.flavor is string && request.resource.data.flavor.size() <= 16 &&
        request.resource.data.active is bool;
      allow update, delete: if false;
    }
    match /contentChallenges/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.get('id', '') == docId &&
        isCatalogChallengeId(docId) &&
        request.resource.data.keys().hasOnly([
          'id', 'title', 'description', 'points', 'type', 'active'
        ]) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 80 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 400 &&
        request.resource.data.points is int && request.resource.data.points >= 0 && request.resource.data.points <= 100 &&
        request.resource.data.type is string && request.resource.data.type.size() <= 32 &&
        request.resource.data.active is bool;
      allow update, delete: if false;
    }
  }
}
